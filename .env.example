# OpenAI Platform: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Conversation and media analysis use gpt-6-astra with
# reasoning: { mode: "pro", effort: "max" }; these settings cannot be overridden.

# Slack app OAuth token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-...

# Slack app Signing Secret (Slack API app > Basic Information)
SLACK_SIGNING_SECRET=...

# Comma-separated Slack channel IDs that may invoke the bot. Leave blank to allow all.
ALLOWED_CHANNEL_IDS=C0123456789

# Keep @gpt conversations in Firestore per Slack thread. Configure the Firestore
# database and grant the Cloud Run service account the Firestore User role first.
FIRESTORE_CONVERSATION_COLLECTION=slack_conversations

# Model used by the Responses API image-generation tool.
OPENAI_IMAGE_MODEL=gpt-image-2

# Slack channel ID for deployment start/completion/failure notifications.
DEPLOYMENT_NOTIFICATION_CHANNEL_ID=C0123456789

# Media worker configuration. `npm run deploy` configures the worker URL and
# task service account on Cloud Run; these are only needed for local overrides.
MEDIA_TASK_QUEUE=gpt-slack-media
MEDIA_TASK_SERVICE_ACCOUNT=gpt-slack-bot-media-task@YOUR_PROJECT_ID.iam.gserviceaccount.com
MEDIA_WORKER_URL=https://YOUR_MEDIA_WORKER_URL
MEDIA_WORKER_AUDIENCE=https://YOUR_MEDIA_WORKER_URL

# Media safety and free-tier guards. Quotas use Asia/Tokyo calendar boundaries.
MEDIA_MAX_DURATION_SECONDS=900
MEDIA_MAX_SLACK_FILE_BYTES=1073741824
MEDIA_DAILY_QUOTA=10
MEDIA_MONTHLY_QUOTA=90
MEDIA_TRANSCRIPT_TTL_DAYS=30
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
