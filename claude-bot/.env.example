# Anthropic Console API key. Do not commit an actual key.
ANTHROPIC_API_KEY=sk-ant-...

# Credentials of the separate Slack app named claude.
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Comma-separated channel IDs. An explicitly empty value allows every channel.
ALLOWED_CHANNEL_IDS=C0123456789
# Match GPT's collection so both bots continue the same Slack thread.
# The deployment script reads the actual collection from gpt-slack-bot.
FIRESTORE_CONVERSATION_COLLECTION=slack_conversations

# Claude Fable 5.1 and maximum reasoning are fixed in the source.
# No OpenAI credentials, image-generation model, or transcription model are used.

# Deployment notifications are posted as @claude. Invite it to this channel first.
# On initial deployment, omitted channel settings can be read from the existing
# GPT service; later deployments use the Claude service's own settings.
DEPLOYMENT_NOTIFICATION_CHANNEL_ID=C0123456789
GOOGLE_CLOUD_PROJECT=mochiduki-gpt-slack-260713
CLOUD_RUN_REGION=asia-northeast1
PORT=8080
